PORT=5000
NODE_ENV=development

# PostgreSQL. On Vercel use the provider's pooled URL here and the direct URL in DIRECT_URL (used for migrations).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DIRECT_URL=

JWT_SECRET=
JWT_EXPIRY=

# Supabase Storage (public bucket) for provider document images
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=homeservice

# OTP SMS gateway (omni.myctrlbox.com). Falls back to the previously hardcoded values when unset.
SMS_USERNAME=
SMS_PASSWORD=
SMS_FROM=
SMS_DLT_CONTENT_ID=

# Comma-separated, used when NODE_ENV=production
ALLOWED_ORIGINS=

# Only for scripts/migrate-mongo-to-postgres.ts (either MONGODB_URI or the three DB_* values)
MONGODB_URI=
DB_USER=
DB_PASSWORD=
DB_NAME=
