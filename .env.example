PORT=5000
NODE_ENV=development

# PostgreSQL. On Vercel use the provider's pooled URL here and the direct URL in DIRECT_URL (used for migrations).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DIRECT_URL=

JWT_SECRET=
JWT_EXPIRY=

# Supabase Storage (public bucket) for provider document images
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=homeservice

# OTP SMS gateway (omni.myctrlbox.com)
SMS_API_URL=https://omni.myctrlbox.com/fe/api/v1/send
SMS_USERNAME=
SMS_PASSWORD=
SMS_FROM=
SMS_DLT_CONTENT_ID=

# Comma-separated web origins (e.g. the admin panel URL), used when NODE_ENV=production.
# Mobile apps (no Origin header) and localhost on any port are always allowed.
ALLOWED_ORIGINS=

# Only for scripts/migrate-mongo-to-postgres.ts (either MONGODB_URI or the three DB_* values)
MONGODB_URI=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Resend email; booking notifications go to the booking user plus BOOKING_NOTIFY_EMAIL
RESEND_KEY=
RESEND_FROM=Bookings <bookings@yourdomain.com>
BOOKING_NOTIFY_EMAIL=

# Razorpay (online booking payments). The key id is sent to the app with each order.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Requests per IP per 15 minutes. The apps poll every ~10s while a job is active.
RATE_LIMIT_MAX=600

# Keeps auto-assignment moving when nobody is polling: an external scheduler (cron-job.org,
# GitHub Actions, ...) calls GET /api/cron/assignments every minute with
# "Authorization: Bearer $CRON_SECRET". See README, "Scheduler".
CRON_SECRET=

# Auto-assignment tunables (all optional; defaults shown).
# ASSIGN_RADIUS_RINGS_KM=5,10,20
# ASSIGN_SLOT_BUFFER_MIN=90
# ASSIGN_EXPIRED_RETRY_COOLDOWN_MIN=10
# ASSIGN_MAX_OFFER_ATTEMPTS=6
# ASSIGN_ESCALATE_AFTER_MIN=15

# Place search for the address form. Defaults to the public Photon (OpenStreetMap) service;
# point it at a self-hosted Photon if traffic grows.
# GEO_PHOTON_URL=https://photon.komoot.io

# Push notifications (off until set). The in-app inbox works without them.
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=

# Local testing only; both are ignored when NODE_ENV=production.
# PAYMENT_MOCK=true fakes Razorpay (signature "mock"); OTP_DEV_ECHO=true returns OTPs in the response.
PAYMENT_MOCK=
OTP_DEV_ECHO=
