{
  "version": 2,
  "framework": null,
  "regions": ["bom1"],
  "buildCommand": "npm run vercel-build && mkdir -p public",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
