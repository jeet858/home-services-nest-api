// Postgres port of the Mongoose models in ../src/models.
// Refs become FKs, id arrays become m2m relations, embedded docs become flat columns.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js" // compiled CJS output requires .js paths
}

datasource db {
  provider = "postgresql"
}

enum Role {
  client
  admin
}

/// Lifecycle of a booking. `pending`/`confirmed` are legacy values kept for old rows.
enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
  searching // visit charge paid, looking for a professional
  offered // offered to a professional, awaiting accept/reject
  accepted // professional accepted
  on_the_way
  arrived
  inspecting // service OTP verified, professional building the quote
  quote_sent // customer reviewing / negotiating
  payment_pending // every task agreed; waiting for online payment or cash confirmation
  in_progress // paid; work under way
}

enum OtpPurpose {
  customer
  provider
}

enum DocumentStatus {
  not_added
  pending
  verified
  rejected
}

enum BookingItemStatus {
  booked // on the original booking, not yet in a quote
  proposed // in a sent quote, awaiting the customer
  accepted
  rejected // rejected by the customer
  countered // last offer is a counter waiting for the other side
  declined // declined by the professional during negotiation
  not_needed // marked by the professional at inspection
}

enum NegotiationParty {
  provider
  customer
}

enum AssignmentStatus {
  offered
  accepted
  rejected
  expired
  cancelled
}

enum PaymentKind {
  visit
  quote
}

enum RecipientType {
  user
  provider
}

enum PayoutStatus {
  scheduled
  processing
  paid
  failed
}

enum RatingStatus {
  pending
  approved
  rejected
}

enum ProviderStatus {
  active
  inactive
  suspended
  pending
  verification_pending
}

enum ExperienceUnit {
  months
  years
}

enum CouponType {
  percent
  flat
  cashback
}

enum PaymentMethod {
  online
  cash
}

enum PaymentStatus {
  pending
  paid
}

/// App users: OTP clients and admins share one table, as in Mongo.
model User {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String    @unique
  name        String?
  email       String?
  password    String
  avatar      String?
  role        Role      @default(client)
  lastLogin   DateTime? // fix: was written by admin login but missing from the Mongo schema
  createdAt   DateTime  @default(now())

  addresses         Address[]
  bookings          Booking[]         @relation("BookingUser")
  assignedBookings  Booking[]         @relation("BookingAssignedBy")
  ratings           Rating[]          @relation("RatingUser")
  reviewedRatings   Rating[]          @relation("RatingReviewedBy")
  createdProviders  ServiceProvider[] @relation("ProviderCreatedBy")
  verifiedProviders ServiceProvider[] @relation("ProviderVerifiedBy")

  @@index([role, createdAt])
  @@index([email])
}

/// Short-lived login OTPs.
model Otp {
  id          String     @id @default(uuid()) @db.Uuid
  phoneNumber String
  otp         String
  expiresAt   DateTime
  purpose     OtpPurpose @default(customer)
  attempts    Int        @default(0)

  @@index([phoneNumber, purpose])
}

/// User addresses (replaces the never-maintained User.addresses array).
model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  label       String? // Home / Office / Other
  houseNo     String?
  street      String
  fullAddress String?
  landmark    String?
  city        String
  state       String
  zip         String
  country     String
  lat         Float? // optional coordinates for map/geo features
  lng         Float?
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([userId, createdAt])
}

/// Top-level service catalogue entry.
model Service {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  process         String?
  originalPrice   Float
  discountedPrice Float
  duration        String
  image           String?
  createdAt       DateTime @default(now())

  // Derived from Subservice.serviceId instead of the duplicated Mongo array.
  subservices Subservice[]
  bookings    Booking[]         @relation("BookingServices")
  providers   ServiceProvider[] @relation("ProviderServices")
  ratings     Rating[]
}

/// Sub-item of a service; this is what bookings and ratings target.
model Subservice {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  serviceId       String   @db.Uuid
  description     String?
  process         String?
  image           String?
  originalPrice   Float
  discountedPrice Float
  duration        String
  createdAt       DateTime @default(now())

  service   Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings  Booking[]         @relation("BookingSubservices")
  providers ServiceProvider[] @relation("ProviderSubservices")
  ratings   Rating[]
  items     BookingItem[]

  @@index([serviceId, createdAt])
}

/// Customer booking of one or more services/subservices.
model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @db.Uuid
  addressId          String?       @db.Uuid
  serviceProviderId  String?       @db.Uuid
  date               DateTime
  time               String
  status             BookingStatus @default(pending)
  discount           Float         @default(0)
  finalPrice         Float
  assignedAt         DateTime?
  assignedById       String?       @db.Uuid
  cancellationReason String? // fix: cancel wrote these but the Mongo schema dropped them
  cancelledAt        DateTime?
  couponCode         String?
  paymentMethod      PaymentMethod @default(cash)
  paymentStatus      PaymentStatus @default(pending)
  razorpayOrderId    String?
  razorpayPaymentId  String?
  // Shared with the pro on arrival to start the job.
  serviceOtp         String?
  notes              String?
  tip                Float         @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  // Set once when auto-matching could not place the booking; the admin team assigns by hand.
  matchEscalatedAt   DateTime?

  // Visit -> inspection -> quote -> payment -> work timeline.
  onTheWayAt       DateTime?
  arrivedAt        DateTime?
  inspectionAt     DateTime?
  otpAttempts      Int       @default(0)
  quoteRound       Int       @default(0)
  quoteSentAt      DateTime?
  quoteApprovedAt  DateTime?
  quoteNote        String?
  issuePhotos      String[]
  afterPhotos      String[]
  cashConfirmedAt  DateTime?
  // Money. finalPrice stays "what the customer pays in total" once a quote is agreed.
  visitingCharge   Float     @default(0)
  visitChargePaid  Boolean   @default(false)
  estimatedTotal   Float     @default(0)
  agreedTotal      Float?
  commissionPct    Float?
  commissionAmount Float?
  providerEarning  Float?

  user            User                @relation("BookingUser", fields: [userId], references: [id], onDelete: Cascade)
  address         Address?            @relation(fields: [addressId], references: [id], onDelete: SetNull)
  serviceProvider ServiceProvider?    @relation(fields: [serviceProviderId], references: [id], onDelete: SetNull)
  assignedBy      User?               @relation("BookingAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  services        Service[]           @relation("BookingServices")
  subservices     Subservice[]        @relation("BookingSubservices")
  ratings         Rating[]
  items           BookingItem[]
  assignments     BookingAssignment[]
  payments        Payment[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([serviceProviderId, status])
  @@index([createdAt])
}

/// One rating per (booking, subservice); reviewed by an admin before counting.
model Rating {
  id                String       @id @default(uuid()) @db.Uuid
  bookingId         String       @db.Uuid
  userId            String       @db.Uuid
  // Nullable so deleting a provider keeps history; required on create in code.
  serviceProviderId String?      @db.Uuid
  subserviceId      String       @db.Uuid
  serviceId         String       @db.Uuid
  rating            Int
  feedback          String
  status            RatingStatus @default(pending)
  reviewedById      String?      @db.Uuid
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  booking         Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user            User             @relation("RatingUser", fields: [userId], references: [id], onDelete: Cascade)
  serviceProvider ServiceProvider? @relation(fields: [serviceProviderId], references: [id], onDelete: SetNull)
  subservice      Subservice       @relation(fields: [subserviceId], references: [id], onDelete: Restrict)
  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  reviewedBy      User?            @relation("RatingReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  // fix: Mongo had unique(booking) while creating one rating per subservice, so multi-subservice bookings failed.
  @@unique([bookingId, subserviceId])
  @@index([userId, status])
  @@index([subserviceId, status])
  @@index([serviceId])
  @@index([rating])
  @@index([createdAt])
}

/// Field worker; aadhaarCard/panCard/bankDetails/rating subdocs are flattened into columns.
model ServiceProvider {
  id                    String         @id @default(uuid()) @db.Uuid
  name                  String
  email                 String         @unique
  phoneNumber           String         @unique
  address               String?
  aadhaarNumber         String?        @unique
  aadhaarImage          String?
  aadhaarS3Key          String?
  aadhaarVerified       Boolean        @default(false)
  panNumber             String?        @unique // Postgres unique allows many NULLs, matching the partial index
  panImage              String?
  panS3Key              String?
  panVerified           Boolean        @default(false)
  passportPhoto         String?
  passportPhotoS3Key    String?
  specializations       String[]
  experience            Float          @default(0)
  experienceUnit        ExperienceUnit @default(years)
  qualification         String?
  // { monday: { start, end, available }, ... } — read as a whole, so JSON is enough.
  availability          Json
  status                ProviderStatus @default(verification_pending)
  ratingAverage         Float          @default(0)
  ratingTotal           Int            @default(0)
  ratingCount1          Int            @default(0)
  ratingCount2          Int            @default(0)
  ratingCount3          Int            @default(0)
  ratingCount4          Int            @default(0)
  ratingCount5          Int            @default(0)
  bankAccountNumber     String?
  bankIfscCode          String?
  bankAccountHolderName String?
  bankName              String?
  commission            Float          @default(10)
  // Nullable so deleting an admin doesn't block; required on create in code.
  createdById           String?        @db.Uuid
  verifiedById          String?        @db.Uuid
  verifiedAt            DateTime?
  notes                 String?
  // Partner app presence.
  isOnline              Boolean        @default(false)
  lastSeenAt            DateTime?
  lat                   Float?
  lng                   Float?
  fcmToken              String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  assignments    BookingAssignment[]
  payouts        Payout[]
  services       Service[]               @relation("ProviderServices")
  subservices    Subservice[]            @relation("ProviderSubservices")
  certifications ProviderCertification[]
  documents      ProviderDocument[]
  bookings       Booking[]
  ratings        Rating[]
  createdBy      User?                   @relation("ProviderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  verifiedBy     User?                   @relation("ProviderVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([status, isOnline])
  @@index([ratingAverage(sort: Desc), ratingTotal(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// Was ServiceProvider.certifications[] in Mongo.
model ProviderCertification {
  id                String    @id @default(uuid()) @db.Uuid
  providerId        String    @db.Uuid
  name              String
  issuingAuthority  String
  issueDate         DateTime?
  expiryDate        DateTime?
  certificateNumber String?

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

/// Was ServiceProvider.documents[] in Mongo.
model ProviderDocument {
  id           String         @id @default(uuid()) @db.Uuid
  providerId   String         @db.Uuid
  type         String
  name         String
  url          String
  uploadedAt   DateTime       @default(now())
  verified     Boolean        @default(false)
  status       DocumentStatus @default(pending)
  rejectReason String?

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

/// Promo codes shown on the Offers screen and applied at checkout.
model Coupon {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @unique
  title        String
  description  String?
  tag          String?
  type         CouponType
  value        Float
  maxDiscount  Float?
  minOrder     Float      @default(0)
  validTill    DateTime?
  perUserLimit Int?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@index([active, validTill])
}

/// One task on a booking: booked from the catalogue, or added by the professional at inspection.
model BookingItem {
  id           String            @id @default(uuid()) @db.Uuid
  bookingId    String            @db.Uuid
  subserviceId String?           @db.Uuid
  name         String
  description  String?
  qty          Int               @default(1)
  catalogPrice Float // unit price from the catalogue at booking time (0 for custom tasks)
  price        Float // unit price currently on the table
  finalPrice   Float? // agreed unit price, set when accepted
  isAdditional Boolean           @default(false)
  reason       String? // why the professional changed the price
  status       BookingItemStatus @default(booked)
  done         Boolean           @default(false)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())

  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  subservice   Subservice?       @relation(fields: [subserviceId], references: [id], onDelete: SetNull)
  negotiations ItemNegotiation[]

  @@index([bookingId, sortOrder])
}

/// One offer on a task. Round 1 is the professional's quote; at most 3 rounds.
model ItemNegotiation {
  id        String           @id @default(uuid()) @db.Uuid
  itemId    String           @db.Uuid
  round     Int
  by        NegotiationParty
  price     Float
  note      String?
  createdAt DateTime         @default(now())

  item BookingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, round])
}

/// A time-boxed offer of a booking to one professional.
model BookingAssignment {
  id          String           @id @default(uuid()) @db.Uuid
  bookingId   String           @db.Uuid
  providerId  String           @db.Uuid
  status      AssignmentStatus @default(offered)
  expiresAt   DateTime
  respondedAt DateTime?
  reason      String?
  // Why this professional was picked: distance to the address and the match score (0..1).
  distanceKm  Float?
  score       Float?
  createdAt   DateTime         @default(now())

  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, status])
  @@index([bookingId, status])
  @@index([status, expiresAt])
}

/// Money received against a booking: the visit charge, then the agreed quote.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  bookingId         String?       @db.Uuid
  userId            String        @db.Uuid
  kind              PaymentKind
  method            PaymentMethod
  amount            Float
  status            PaymentStatus @default(pending)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([userId, kind, status])
}

/// In-app inbox for customers and professionals.
model Notification {
  id            String        @id @default(uuid()) @db.Uuid
  recipientType RecipientType
  recipientId   String        @db.Uuid
  type          String
  title         String
  body          String
  bookingId     String?       @db.Uuid
  data          Json?
  readAt        DateTime?
  createdAt     DateTime      @default(now())

  @@index([recipientType, recipientId, createdAt(sort: Desc)])
  @@index([recipientType, recipientId, readAt])
}

/// Settlement of a professional's earnings to their bank account.
model Payout {
  id          String       @id @default(uuid()) @db.Uuid
  providerId  String       @db.Uuid
  amount      Float
  periodStart DateTime
  periodEnd   DateTime
  status      PayoutStatus @default(scheduled)
  utr         String?
  paidAt      DateTime?
  createdAt   DateTime     @default(now())

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt(sort: Desc)])
}
