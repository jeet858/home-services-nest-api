{
  "name": "home-services-nest-api",
  "version": "1.0.0",
  "description": "NestJS + Prisma (PostgreSQL) port of the home services API",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev && prisma generate",
    "migrate:mongo": "tsx scripts/migrate-mongo-to-postgres.ts",
    "seed:coupons": "tsx scripts/seed-coupons.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:demo:clean": "tsx scripts/seed-demo.ts --clean",
    "check:circular": "madge --circular --extensions ts --exclude generated src",
    "vercel-build": "prisma generate && nest build"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.117.2",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "madge": "^8.0.0",
    "mongodb": "^7.6.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
